{
  "compilerOptions": {
    "module": "CommonJS",          
    "moduleResolution": "node",     
    "esModuleInterop": true,        
    "allowSyntheticDefaultImports": true,  
    "target": "ES2020",
    "lib": ["ES2020"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,           
    "outDir": "lib",
    "rootDir": "src"
  },
  "include": ["src"]
}