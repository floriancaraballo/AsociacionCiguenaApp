<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ========================================
         PERMISOS
         ======================================== -->

    <!-- Obligatorios para Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Para descargar/ver fotos de excursiones -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Para Android 12 y anteriores (fallback) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Permisos para acceder a fotos -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Para subir fotos (solo admin) - opcional -->
    <!-- <uses-permission android:name="android.permission.CAMERA" /> -->
    <queries>
        <!-- Required for Google Play Services -->
        <package android:name="com.google.android.gms" />

        <!-- Optional: Also query Play Store -->
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:name=".AsociacionCiguenaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AsociacionCigueña"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu">

        <!-- ========================================
             ACTIVIDAD PRINCIPAL
             ======================================== -->
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AsociacionCigueña">

            <!-- Splash Screen theme -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ========================================
             CONFIGURACIÓN DE FIREBASE
             (Se añadirá automáticamente al conectar Firebase)
             ======================================== -->
    </application>

</manifest>